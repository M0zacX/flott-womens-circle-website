---
const navLinks = [
  { label: "Home", href: "/" },
  { label: "About", href: "/about" },
  { label: "Focus Areas", href: "/focus-areas" },
  { label: "Our Circles", href: "/circles" },
  { label: "Circle Experts", href: "/circle-expert" },
  { label: "Programs", href: "/programs" },
  { label: "Gallery", href: "/gallery" },
  { label: "Contact", href: "/contact" },
];
---

<footer class="bg-background relative overflow-hidden">
  <!-- Decorative mandala SVG -->
  <svg class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] md:w-[650px] md:h-[650px] lg:w-[800px] lg:h-[800px] text-[#e8b4b8] opacity-[0.12] pointer-events-none" viewBox="0 0 400 400" fill="none" stroke="currentColor" stroke-width="0.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <!-- Outer circles -->
    <circle cx="200" cy="200" r="195" />
    <circle cx="200" cy="200" r="180" />
    <circle cx="200" cy="200" r="155" />
    <!-- Scalloped ring -->
    <path d="M200 25 Q215 45 200 50 Q185 45 200 25" />
    <path d="M200 375 Q215 355 200 350 Q185 355 200 375" />
    <path d="M25 200 Q45 185 50 200 Q45 215 25 200" />
    <path d="M375 200 Q355 185 350 200 Q355 215 375 200" />
    <!-- Diagonal scallops -->
    <path d="M76 76 Q98 82 88 98 Q82 98 76 76" />
    <path d="M324 76 Q302 82 312 98 Q318 98 324 76" />
    <path d="M76 324 Q82 302 98 312 Q98 318 76 324" />
    <path d="M324 324 Q318 302 302 312 Q302 318 324 324" />
    <!-- Inner petal ring — 12 petals -->
    <path d="M200 60 Q212 100 200 130 Q188 100 200 60Z" />
    <path d="M200 340 Q212 300 200 270 Q188 300 200 340Z" />
    <path d="M60 200 Q100 188 130 200 Q100 212 60 200Z" />
    <path d="M340 200 Q300 188 270 200 Q300 212 340 200Z" />
    <path d="M100 100 Q125 115 140 140 Q115 125 100 100Z" />
    <path d="M300 100 Q275 115 260 140 Q285 125 300 100Z" />
    <path d="M100 300 Q115 275 140 260 Q125 285 100 300Z" />
    <path d="M300 300 Q285 275 260 260 Q275 285 300 300Z" />
    <path d="M148 68 Q168 102 165 135 Q152 98 148 68Z" />
    <path d="M252 68 Q232 102 235 135 Q248 98 252 68Z" />
    <path d="M148 332 Q152 302 165 265 Q168 298 148 332Z" />
    <path d="M252 332 Q248 302 235 265 Q232 298 252 332Z" />
    <!-- Second ring of smaller petals -->
    <path d="M200 110 Q208 140 200 160 Q192 140 200 110Z" />
    <path d="M200 290 Q208 260 200 240 Q192 260 200 290Z" />
    <path d="M110 200 Q140 192 160 200 Q140 208 110 200Z" />
    <path d="M290 200 Q260 192 240 200 Q260 208 290 200Z" />
    <path d="M135 135 Q152 148 162 162 Q148 152 135 135Z" />
    <path d="M265 135 Q248 148 238 162 Q252 152 265 135Z" />
    <path d="M135 265 Q148 252 162 238 Q152 248 135 265Z" />
    <path d="M265 265 Q252 248 238 238 Q248 252 265 265Z" />
    <!-- Center mandala -->
    <circle cx="200" cy="200" r="55" />
    <circle cx="200" cy="200" r="38" />
    <circle cx="200" cy="200" r="18" />
    <circle cx="200" cy="200" r="6" fill="currentColor" opacity="0.3" />
    <!-- Center rays -->
    <line x1="200" y1="162" x2="200" y2="145" />
    <line x1="200" y1="238" x2="200" y2="255" />
    <line x1="162" y1="200" x2="145" y2="200" />
    <line x1="238" y1="200" x2="255" y2="200" />
    <line x1="173" y1="173" x2="162" y2="162" />
    <line x1="227" y1="173" x2="238" y2="162" />
    <line x1="173" y1="227" x2="162" y2="238" />
    <line x1="227" y1="227" x2="238" y2="238" />
    <!-- Dot ring between inner circles -->
    <circle cx="200" cy="130" r="3" /><circle cx="200" cy="270" r="3" />
    <circle cx="130" cy="200" r="3" /><circle cx="270" cy="200" r="3" />
    <circle cx="150" cy="150" r="2.5" /><circle cx="250" cy="150" r="2.5" />
    <circle cx="150" cy="250" r="2.5" /><circle cx="250" cy="250" r="2.5" />
    <circle cx="170" cy="118" r="2" /><circle cx="230" cy="118" r="2" />
    <circle cx="170" cy="282" r="2" /><circle cx="230" cy="282" r="2" />
    <circle cx="118" cy="170" r="2" /><circle cx="118" cy="230" r="2" />
    <circle cx="282" cy="170" r="2" /><circle cx="282" cy="230" r="2" />
  </svg>

  <!-- Row 1: Logo + Nav -->
  <div class="border-t border-border px-6 pt-14 pb-10 md:px-12 lg:px-20">
    <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
      <a href="/" class="footer-reveal" style="transition-delay: 0s">
        <img src="/images/flott-women-circle-logo.png" alt="Flott Women's Circle" class="h-10 w-auto" />
      </a>
      <nav class="flex flex-wrap gap-x-4 sm:gap-x-6 md:gap-x-8 gap-y-3">
        {navLinks.map((link, i) => (
          <a href={link.href} class="footer-reveal text-xs uppercase tracking-[0.15em] text-muted-foreground transition-colors hover:text-foreground" style={`transition-delay: ${0.05 + i * 0.06}s`}>{link.label}</a>
        ))}
      </nav>
    </div>
  </div>

  <!-- Member forms — dark download band -->
  <div class="dl-band">
    <div class="dl-band-glow" aria-hidden="true"></div>
    <div class="dl-band-inner">
      <div class="dl-band-head footer-reveal" style="transition-delay: 0.1s">
        <p class="dl-eyebrow"><span class="dl-eyebrow-mark">✦</span> Member Onboarding</p>
        <h3 class="dl-band-title">Prefer to <em>print &amp; fill by hand?</em></h3>
        <p class="dl-band-sub">Download any of the FWC Dubai member forms below. Enter your email once, then grab the ones you need — ready to print, complete and bring to your first gathering.</p>
        <div class="dl-email-field">
          <svg class="dl-email-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          <input type="email" id="dl-email" required placeholder="Enter your email to unlock the downloads" aria-label="Your email address" />
        </div>
      </div>

      <div id="footer-dl" class="dl-cards">
        <button type="button" class="dl-card footer-reveal" data-dl="/downloads/FWC-Dubai-Diagnostic-Form.pdf" style="transition-delay: 0.2s">
          <span class="dl-card-top">
            <span class="dl-card-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/></svg></span>
            <span class="dl-card-n">01</span>
          </span>
          <span class="dl-card-t">Discovery Diagnostic Form</span>
          <span class="dl-card-d">Your economic opportunity mapping</span>
          <span class="dl-card-act"><span class="dl-opt-label">Download PDF</span><svg class="dl-card-dlic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></span>
        </button>

        <button type="button" class="dl-card footer-reveal" data-dl="/downloads/FWC-Dubai-Confidentiality-Agreement.pdf" style="transition-delay: 0.3s">
          <span class="dl-card-top">
            <span class="dl-card-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg></span>
            <span class="dl-card-n">02</span>
          </span>
          <span class="dl-card-t">Confidentiality &amp; Participation</span>
          <span class="dl-card-d">The community trust agreement</span>
          <span class="dl-card-act"><span class="dl-opt-label">Download PDF</span><svg class="dl-card-dlic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></span>
        </button>

        <button type="button" class="dl-card footer-reveal" data-dl="/downloads/FWC-Dubai-PhotoVideo-Consent.pdf" style="transition-delay: 0.4s">
          <span class="dl-card-top">
            <span class="dl-card-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg></span>
            <span class="dl-card-n">03</span>
          </span>
          <span class="dl-card-t">Photography &amp; Video Consent</span>
          <span class="dl-card-d">Choose how your image is used</span>
          <span class="dl-card-act"><span class="dl-opt-label">Download PDF</span><svg class="dl-card-dlic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></span>
        </button>
      </div>
    </div>
  </div>

  <!-- Divider -->
  <div class="mx-6 md:mx-12 lg:mx-20 footer-reveal border-t border-border" style="transition-delay: 0.4s; transform-origin: left;"></div>

  <!-- Row 2: Contact info + Social -->
  <div class="px-6 py-10 md:px-12 lg:px-20">
    <div class="flex flex-col gap-8 md:flex-row md:items-center md:justify-between">
      <div class="flex flex-col gap-6 sm:flex-row sm:gap-12 lg:gap-20">
        <!-- Address -->
        <div class="footer-reveal flex items-start gap-3" style="transition-delay: 0.5s">
          <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-border">
            <svg class="h-4 w-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
          </div>
          <div>
            <p class="text-xs font-medium text-muted-foreground/60 uppercase tracking-wider">Address:</p>
            <p class="mt-1 text-sm text-foreground">No. 6 Ubiaja Crescent, Garki 2, Abuja</p>
          </div>
        </div>
        <!-- Instagram -->
        <div class="footer-reveal flex items-start gap-3" style="transition-delay: 0.6s">
          <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-border">
            <svg class="h-4 w-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </div>
          <div>
            <p class="text-xs font-medium text-muted-foreground/60 uppercase tracking-wider">Instagram:</p>
            <p class="mt-1 text-sm text-foreground">@flott_beauty</p>
          </div>
        </div>
        <!-- Email -->
        <div class="footer-reveal flex items-start gap-3" style="transition-delay: 0.7s">
          <div class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-border">
            <svg class="h-4 w-4 text-muted-foreground" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M16 8v5a3 3 0 0 0 6 0V12a10 10 0 1 0-3.92 7.94"/></svg>
          </div>
          <div>
            <p class="text-xs font-medium text-muted-foreground/60 uppercase tracking-wider">Email:</p>
            <p class="mt-1 text-sm text-foreground">info@flottwomen.com</p>
          </div>
        </div>
      </div>

      <!-- Social icons -->
      <div class="flex items-center gap-3">
        <a href="https://instagram.com/flott_beauty" target="_blank" rel="noopener noreferrer" class="footer-reveal flex h-10 w-10 items-center justify-center rounded-full border border-border text-muted-foreground transition-colors hover:border-foreground hover:text-foreground" style="transition-delay: 0.8s" aria-label="Instagram">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
        <a href="#" class="footer-reveal flex h-10 w-10 items-center justify-center rounded-full border border-border text-muted-foreground transition-colors hover:border-foreground hover:text-foreground" style="transition-delay: 0.85s" aria-label="Facebook">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Divider -->
  <div class="mx-6 md:mx-12 lg:mx-20 footer-reveal border-t border-border" style="transition-delay: 0.95s;"></div>

  <!-- Row 3: Copyright + Legal -->
  <div class="px-6 py-6 md:px-12 lg:px-20">
    <div class="flex flex-col items-center justify-between gap-3 md:flex-row">
      <p class="footer-reveal text-xs text-muted-foreground/50" style="transition-delay: 1s">Copyright &copy; 2026 &ndash; Developed by <span class="text-muted-foreground">MozacX</span></p>
      <div class="flex items-center gap-6">
        <a href="#" class="footer-reveal text-xs text-muted-foreground/50 transition-colors hover:text-foreground" style="transition-delay: 1.05s">Privacy Policy</a>
        <a href="#" class="footer-reveal text-xs text-muted-foreground/50 transition-colors hover:text-foreground" style="transition-delay: 1.1s">Terms of Use</a>
      </div>
    </div>
  </div>

  <script>
    // Footer-specific observer with lower threshold so it triggers at page bottom
    const footerObs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("visible");
            footerObs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.01, rootMargin: "0px 0px 0px 0px" }
    );
    document.querySelectorAll(".footer-reveal").forEach((el) => footerObs.observe(el));

    // Member forms — 3 options, email captured once, then any file downloads
    const dlEmail = document.getElementById("dl-email");
    const dlOpts = Array.from(document.querySelectorAll("#footer-dl .dl-card"));
    let dlCaptured = false;
    dlOpts.forEach((btn) => {
      btn.addEventListener("click", async () => {
        if (!dlEmail.checkValidity()) { dlEmail.reportValidity(); return; }
        const file = btn.getAttribute("data-dl");
        const lbl = btn.querySelector(".dl-opt-label");
        const original = lbl ? lbl.textContent : "";
        if (lbl) lbl.textContent = "Preparing…";
        if (!dlCaptured) {
          try {
            const fd = new FormData();
            fd.append("access_key", "e80680ce-9b98-4fe1-b6b5-58893c5fac01");
            fd.append("subject", "Member Forms Download — Flott Women's Circle");
            fd.append("from_name", "Flott Website — Forms Download");
            fd.append("email", dlEmail.value);
            fd.append("message", "Requested a member form (print & fill) via the website footer.");
            fd.append("botcheck", "");
            await fetch("https://api.web3forms.com/submit", { method: "POST", body: fd });
            dlCaptured = true;
          } catch (_) { /* still let them download */ }
        }
        const a = document.createElement("a");
        a.href = file;
        a.setAttribute("download", "");
        document.body.appendChild(a); a.click(); a.remove();
        if (lbl) lbl.textContent = "Downloaded ✓";
        setTimeout(() => { if (lbl) lbl.textContent = original; }, 2800);
      });
    });
  </script>
</footer>

<style>
  .footer-reveal {
    opacity: 0;
    transform: translateY(20px);
    filter: blur(6px);
    will-change: opacity, transform, filter;
    transition:
      opacity 1.2s cubic-bezier(0.22, 1, 0.36, 1),
      transform 1.2s cubic-bezier(0.22, 1, 0.36, 1),
      filter 1.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .footer-reveal.visible {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  /* ── Member forms dark download band ── */
  .dl-band {
    position: relative;
    overflow: hidden;
    margin: 8px 0;
    background: linear-gradient(160deg, #1c1410 0%, #140d09 55%, #100b07 100%);
    padding: 60px 24px;
  }
  @media (min-width: 768px) { .dl-band { padding: 76px 48px; } }
  @media (min-width: 1024px) { .dl-band { padding: 84px 80px; } }
  .dl-band-glow {
    position: absolute;
    top: -30%;
    left: 50%;
    transform: translateX(-50%);
    width: 900px;
    height: 520px;
    background: radial-gradient(ellipse at center, rgba(196,146,152,0.18) 0%, rgba(196,146,152,0.06) 40%, transparent 70%);
    pointer-events: none;
  }
  .dl-band-inner { position: relative; max-width: 1040px; margin: 0 auto; }

  .dl-band-head { text-align: center; max-width: 620px; margin: 0 auto 44px; }
  .dl-eyebrow {
    font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase;
    color: #d9a7ac; margin-bottom: 16px;
  }
  .dl-eyebrow-mark { color: #c49298; margin-right: 6px; }
  .dl-band-title {
    font-size: 27px; line-height: 1.15; font-weight: 500; letter-spacing: -0.01em;
    color: #f6efe9;
  }
  .dl-band-title em {
    font-family: 'Playfair Display', serif; font-style: italic; font-weight: 500;
    color: #e6bcc0;
  }
  @media (min-width: 768px) { .dl-band-title { font-size: 34px; } }
  .dl-band-sub {
    margin-top: 16px; font-size: 14px; line-height: 1.65;
    color: rgba(246,239,233,0.62);
  }

  .dl-email-field {
    position: relative; display: flex; align-items: center;
    max-width: 440px; margin: 28px auto 0;
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.14);
    border-radius: 9999px;
    padding: 4px 6px 4px 18px;
    transition: border-color 0.4s cubic-bezier(0.22,1,0.36,1), background-color 0.4s;
  }
  .dl-email-field:focus-within { border-color: #c49298; background: rgba(255,255,255,0.08); }
  .dl-email-ic { width: 18px; height: 18px; color: rgba(246,239,233,0.5); flex: none; margin-right: 10px; }
  .dl-email-field input {
    flex: 1; min-width: 0; background: transparent; border: 0; outline: none;
    padding: 12px 0; font-size: 14px; color: #f6efe9;
  }
  .dl-email-field input::placeholder { color: rgba(246,239,233,0.4); }

  .dl-cards { display: grid; grid-template-columns: 1fr; gap: 16px; }
  @media (min-width: 768px) { .dl-cards { grid-template-columns: repeat(3, 1fr); gap: 18px; } }
  .dl-card {
    display: flex; flex-direction: column; align-items: flex-start;
    text-align: left; cursor: pointer;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.10);
    border-radius: 18px;
    padding: 24px 22px 20px;
    transition: transform 0.4s cubic-bezier(0.22,1,0.36,1), border-color 0.4s, background-color 0.4s;
  }
  .dl-card:hover {
    transform: translateY(-4px);
    border-color: rgba(196,146,152,0.55);
    background: rgba(196,146,152,0.08);
  }
  .dl-card-top { display: flex; align-items: center; justify-content: space-between; width: 100%; margin-bottom: 18px; }
  .dl-card-ic {
    display: inline-flex; align-items: center; justify-content: center;
    width: 46px; height: 46px; border-radius: 12px;
    background: rgba(196,146,152,0.14); color: #e6bcc0;
    transition: background-color 0.4s, color 0.4s;
  }
  .dl-card-ic svg { width: 22px; height: 22px; }
  .dl-card:hover .dl-card-ic { background: #c49298; color: #1c1410; }
  .dl-card-n {
    font-family: 'Playfair Display', serif; font-style: italic;
    font-size: 26px; color: rgba(246,239,233,0.28);
  }
  .dl-card-t { font-size: 15.5px; font-weight: 500; color: #f6efe9; line-height: 1.3; }
  .dl-card-d { margin-top: 5px; font-size: 12.5px; line-height: 1.5; color: rgba(246,239,233,0.5); }
  .dl-card-act {
    display: inline-flex; align-items: center; gap: 8px; margin-top: 20px;
    font-size: 10.5px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.15em;
    color: #d9a7ac; transition: color 0.4s, gap 0.4s;
  }
  .dl-card-dlic { width: 15px; height: 15px; }
  .dl-card:hover .dl-card-act { color: #f6efe9; gap: 12px; }
</style>
