---
// Member onboarding — dark download band. Placed in the page flow.
---

<section class="dl-band">
  <div class="dl-band-glow" aria-hidden="true"></div>
  <div class="dl-band-inner">
    <div class="dl-band-head mf-reveal">
      <p class="dl-eyebrow"><span class="dl-eyebrow-mark">✦</span> Member Onboarding</p>
      <h3 class="dl-band-title">Your <em>member forms</em>, ready to fill in</h3>
      <p class="dl-band-sub">Download any form below, fill it in right on your phone or laptop, then email the completed form back to us at <span class="dl-mail">info@flottwomenscircle.com</span>. Pop in your email once to unlock the downloads.</p>
      <div class="dl-email-field">
        <svg class="dl-email-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        <input type="email" id="dl-email" required placeholder="Enter your email to unlock the downloads" aria-label="Your email address" />
      </div>
    </div>

    <div id="member-dl" class="dl-cards">
      <button type="button" class="dl-card mf-reveal" data-dl="/downloads/FWC-Dubai-Diagnostic-Form.pdf" style="transition-delay: 0.1s">
        <span class="dl-card-top">
          <span class="dl-card-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="4" x="8" y="2" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><path d="M12 11h4"/><path d="M12 16h4"/><path d="M8 11h.01"/><path d="M8 16h.01"/></svg></span>
          <span class="dl-card-n">01</span>
        </span>
        <span class="dl-card-t">Discovery Diagnostic Form</span>
        <span class="dl-card-d">Your economic opportunity mapping</span>
        <span class="dl-card-act"><span class="dl-opt-label">Download PDF</span><svg class="dl-card-dlic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></span>
      </button>

      <button type="button" class="dl-card mf-reveal" data-dl="/downloads/FWC-Dubai-Confidentiality-Agreement.pdf" style="transition-delay: 0.2s">
        <span class="dl-card-top">
          <span class="dl-card-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg></span>
          <span class="dl-card-n">02</span>
        </span>
        <span class="dl-card-t">Confidentiality &amp; Participation</span>
        <span class="dl-card-d">The community trust agreement</span>
        <span class="dl-card-act"><span class="dl-opt-label">Download PDF</span><svg class="dl-card-dlic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></span>
      </button>

      <button type="button" class="dl-card mf-reveal" data-dl="/downloads/FWC-Dubai-PhotoVideo-Consent.pdf" style="transition-delay: 0.3s">
        <span class="dl-card-top">
          <span class="dl-card-ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg></span>
          <span class="dl-card-n">03</span>
        </span>
        <span class="dl-card-t">Photography &amp; Video Consent</span>
        <span class="dl-card-d">Choose how your image is used</span>
        <span class="dl-card-act"><span class="dl-opt-label">Download PDF</span><svg class="dl-card-dlic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></span>
      </button>
    </div>
  </div>
</section>

<script>
  // Reveal on scroll
  const mfObs = new IntersectionObserver((entries) => {
    entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("visible"); mfObs.unobserve(e.target); } });
  }, { threshold: 0.08 });
  document.querySelectorAll(".mf-reveal").forEach((el) => mfObs.observe(el));

  // Member forms — 3 options, email captured once, then any file downloads
  const dlEmail = document.getElementById("dl-email");
  const dlOpts = Array.from(document.querySelectorAll("#member-dl .dl-card"));
  let dlCaptured = false;
  dlOpts.forEach((btn) => {
    btn.addEventListener("click", async () => {
      if (!dlEmail.checkValidity()) { dlEmail.reportValidity(); return; }
      const file = btn.getAttribute("data-dl");
      const lbl = btn.querySelector(".dl-opt-label");
      const original = lbl ? lbl.textContent : "";
      if (lbl) lbl.textContent = "Preparing…";
      if (!dlCaptured) {
        try {
          const fd = new FormData();
          fd.append("access_key", "e80680ce-9b98-4fe1-b6b5-58893c5fac01");
          fd.append("subject", "Member Forms Download — Flott Women's Circle");
          fd.append("from_name", "Flott Website — Forms Download");
          fd.append("email", dlEmail.value);
          fd.append("message", "Requested a member form (fill on device) via the website.");
          fd.append("botcheck", "");
          await fetch("https://api.web3forms.com/submit", { method: "POST", body: fd });
          dlCaptured = true;
        } catch (_) { /* still let them download */ }
      }
      const a = document.createElement("a");
      a.href = file; a.setAttribute("download", "");
      document.body.appendChild(a); a.click(); a.remove();
      if (lbl) lbl.textContent = "Downloaded ✓";
      setTimeout(() => { if (lbl) lbl.textContent = original; }, 2800);
    });
  });
</script>

<style>
  .dl-band {
    position: relative; overflow: hidden;
    background: linear-gradient(160deg, #1c1410 0%, #140d09 55%, #100b07 100%);
    padding: 64px 24px;
  }
  @media (min-width: 768px) { .dl-band { padding: 88px 48px; } }
  @media (min-width: 1024px) { .dl-band { padding: 104px 80px; } }
  .dl-band-glow {
    position: absolute; top: -30%; left: 50%; transform: translateX(-50%);
    width: 900px; height: 520px;
    background: radial-gradient(ellipse at center, rgba(196,146,152,0.18) 0%, rgba(196,146,152,0.06) 40%, transparent 70%);
    pointer-events: none;
  }
  .dl-band-inner { position: relative; max-width: 1040px; margin: 0 auto; }
  .dl-band-head { text-align: center; max-width: 620px; margin: 0 auto 44px; }
  .dl-eyebrow { font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; color: #d9a7ac; margin-bottom: 16px; }
  .dl-eyebrow-mark { color: #c49298; margin-right: 6px; }
  .dl-band-title { font-size: 27px; line-height: 1.15; font-weight: 500; letter-spacing: -0.01em; color: #f6efe9; }
  .dl-band-title em { font-family: 'Playfair Display', serif; font-style: italic; font-weight: 500; color: #e6bcc0; }
  @media (min-width: 768px) { .dl-band-title { font-size: 34px; } }
  .dl-band-sub { margin-top: 16px; font-size: 14px; line-height: 1.65; color: rgba(246,239,233,0.62); }
  .dl-mail { color: #e6bcc0; white-space: nowrap; }

  .dl-email-field {
    position: relative; display: flex; align-items: center;
    max-width: 440px; margin: 28px auto 0;
    background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.14);
    border-radius: 9999px; padding: 4px 6px 4px 18px;
    transition: border-color 0.4s cubic-bezier(0.22,1,0.36,1), background-color 0.4s;
  }
  .dl-email-field:focus-within { border-color: #c49298; background: rgba(255,255,255,0.08); }
  .dl-email-ic { width: 18px; height: 18px; color: rgba(246,239,233,0.5); flex: none; margin-right: 10px; }
  .dl-email-field input { flex: 1; min-width: 0; background: transparent; border: 0; outline: none; padding: 12px 0; font-size: 14px; color: #f6efe9; }
  .dl-email-field input::placeholder { color: rgba(246,239,233,0.4); }

  .dl-cards { display: grid; grid-template-columns: 1fr; gap: 16px; }
  @media (min-width: 768px) { .dl-cards { grid-template-columns: repeat(3, 1fr); gap: 18px; } }
  .dl-card {
    display: flex; flex-direction: column; align-items: flex-start; text-align: left; cursor: pointer;
    background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.10);
    border-radius: 18px; padding: 24px 22px 20px;
    transition: transform 0.4s cubic-bezier(0.22,1,0.36,1), border-color 0.4s, background-color 0.4s;
  }
  .dl-card:hover { transform: translateY(-4px); border-color: rgba(196,146,152,0.55); background: rgba(196,146,152,0.08); }
  .dl-card-top { display: flex; align-items: center; justify-content: space-between; width: 100%; margin-bottom: 18px; }
  .dl-card-ic {
    display: inline-flex; align-items: center; justify-content: center;
    width: 46px; height: 46px; border-radius: 12px;
    background: rgba(196,146,152,0.14); color: #e6bcc0; transition: background-color 0.4s, color 0.4s;
  }
  .dl-card-ic svg { width: 22px; height: 22px; }
  .dl-card:hover .dl-card-ic { background: #c49298; color: #1c1410; }
  .dl-card-n { font-family: 'Playfair Display', serif; font-style: italic; font-size: 26px; color: rgba(246,239,233,0.28); }
  .dl-card-t { font-size: 15.5px; font-weight: 500; color: #f6efe9; line-height: 1.3; }
  .dl-card-d { margin-top: 5px; font-size: 12.5px; line-height: 1.5; color: rgba(246,239,233,0.5); }
  .dl-card-act { display: inline-flex; align-items: center; gap: 8px; margin-top: 20px; font-size: 10.5px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.15em; color: #d9a7ac; transition: color 0.4s, gap 0.4s; }
  .dl-card-dlic { width: 15px; height: 15px; }
  .dl-card:hover .dl-card-act { color: #f6efe9; gap: 12px; }

  .mf-reveal { opacity: 0; transform: translateY(24px); filter: blur(6px); transition: opacity 1s cubic-bezier(0.22,1,0.36,1), transform 1s cubic-bezier(0.22,1,0.36,1), filter 1.2s cubic-bezier(0.22,1,0.36,1); }
  .mf-reveal.visible { opacity: 1; transform: none; filter: blur(0); }
</style>
