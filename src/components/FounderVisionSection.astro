---
// Founder's Vision — Safiya Umar's story behind Flott Women's Circle
---

<section class="fv-section relative overflow-hidden bg-background">

  <!-- Decorative paisley (top-right, large) -->
  <svg
    class="fv-floral-right hidden lg:block"
    viewBox="0 0 320 480"
    fill="none"
    stroke="currentColor"
    stroke-width="1"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <!-- Main paisley teardrop -->
    <path d="M160 20 C230 60 260 180 220 290 C200 340 170 400 160 440 C150 400 120 340 100 290 C60 180 90 60 160 20Z" />
    <!-- Inner teardrop -->
    <path d="M160 55 C210 85 230 180 200 270 C185 310 165 360 160 380 C155 360 135 310 120 270 C90 180 110 85 160 55Z" />
    <!-- Center motif -->
    <circle cx="160" cy="200" r="18" />
    <circle cx="160" cy="200" r="10" />
    <circle cx="160" cy="200" r="3" />
    <!-- Petal accents -->
    <path d="M160 180 Q170 170 160 158 Q150 170 160 180Z" />
    <path d="M178 200 Q192 196 200 186 Q188 196 178 200Z" />
    <path d="M160 218 Q170 228 160 240 Q150 228 160 218Z" />
    <path d="M142 200 Q128 196 120 186 Q132 196 142 200Z" />
    <!-- Top ornament -->
    <circle cx="160" cy="30" r="4" />
    <circle cx="160" cy="30" r="9" />
    <path d="M160 18 Q155 8 160 -2 Q165 8 160 18Z" />
    <!-- Little dots along curves -->
    <circle cx="100" cy="130" r="1.5" />
    <circle cx="220" cy="130" r="1.5" />
    <circle cx="110" cy="320" r="1.5" />
    <circle cx="210" cy="320" r="1.5" />
    <!-- Bottom scrolls -->
    <path d="M160 400 C140 410 120 408 115 395 C112 385 125 380 135 390" />
    <path d="M160 400 C180 410 200 408 205 395 C208 385 195 380 185 390" />
  </svg>

  <!-- Small accent floral (bottom-left) -->
  <svg
    class="fv-floral-left"
    viewBox="0 0 180 260"
    fill="none"
    stroke="currentColor"
    stroke-width="1"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <!-- Small paisley -->
    <path d="M90 10 C130 35 145 110 125 170 C115 200 95 240 90 252 C85 240 65 200 55 170 C35 110 50 35 90 10Z" />
    <circle cx="90" cy="120" r="8" />
    <circle cx="90" cy="120" r="3" />
    <path d="M90 104 Q96 96 90 88 Q84 96 90 104Z" />
    <path d="M106 120 Q118 117 124 110 Q114 117 106 120Z" />
    <path d="M90 136 Q96 144 90 152 Q84 144 90 136Z" />
    <path d="M74 120 Q62 117 56 110 Q66 117 74 120Z" />
    <circle cx="90" cy="18" r="3" />
  </svg>

  <div class="relative z-10 px-6 py-20 md:px-12 md:py-28 lg:px-20 lg:py-32">

    <!-- Eyebrow -->
    <div class="text-center mb-10 md:mb-14">
      <p class="blur-words text-xs uppercase tracking-[0.3em] text-muted-foreground" style="font-style: italic">
        The Founder's Vision
      </p>
    </div>

    <!-- Two-column grid -->
    <div class="fv-grid mx-auto">

      <!-- LEFT: Story -->
      <div class="fv-content">
        <h2 class="word-blur-group fv-heading text-3xl font-medium tracking-tight text-foreground md:text-4xl lg:text-5xl">
          <span class="word-blur" style="transition-delay: 0s">A</span>
          <span class="word-blur" style="transition-delay: 0.1s">System</span>
          <span class="word-blur" style="transition-delay: 0.2s">Designed</span>
          <span class="word-blur" style="transition-delay: 0.3s">For</span>
          <span class="word-blur" style="transition-delay: 0.45s; font-family: 'Playfair Display', serif; font-style: italic; font-weight: 500;">Growth.</span>
        </h2>

        <div class="fv-divider reveal" style="transition-delay: 0.3s"></div>

        <div class="fv-paragraphs">
          <p class="reveal fv-body" style="transition-delay: 0.15s">
            Flott Women Circle was founded by <span class="fv-highlight">Safiya Umar</span> as a structured extension of Flott Beauty, created to move beyond services into community, skills development, and economic empowerment for women.
          </p>

          <p class="reveal fv-body" style="transition-delay: 0.25s">
            The initiative is built on a simple idea: when women are given access to practical skills, safe spaces, and the right support systems, growth becomes inevitable.
          </p>

          <p class="reveal fv-body" style="transition-delay: 0.35s">
            Across multiple cities, the Circle brings women together through wellness education, conversations, and skill-based programs designed to build confidence, independence, and long-term economic value.
          </p>

          <p class="reveal fv-body fv-body-accent" style="transition-delay: 0.5s">
            This is not just a community. It is a system designed to help women <em class="fv-em">grow</em>, personally and economically.
          </p>
        </div>
      </div>

      <!-- RIGHT: Portrait -->
      <div class="fv-image-column">
        <!-- Number ornament -->
        <div class="fv-number reveal" style="transition-delay: 0.05s">
          <span class="fv-number-label">Ch.</span>
          <span class="fv-number-digit">01</span>
        </div>

        <!-- Image card — arched backdrop with portrait overflowing the top -->
        <div class="fv-image-card">
          <!-- Cream arched backdrop (sits behind, shorter than image) -->
          <div class="fv-image-backdrop" aria-hidden="true"></div>

          <!-- Image wrap (taller than backdrop, breaks out at top) -->
          <div class="fv-image-wrap">
            <img
              src="/images/ceo.webp"
              alt="Safiya Umar, Founder of Flott Women's Circle"
              class="fv-image"
              loading="eager"
            />
          </div>

          <!-- Floating name plaque -->
          <div class="fv-plaque">
            <p class="fv-plaque-label">Founded by</p>
            <p class="fv-plaque-name">Safiya Umar</p>
            <div class="fv-plaque-line"></div>
            <p class="fv-plaque-role">Founder &amp; Group CEO</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ═══════════════════════════════════════════════
     FLORAL DECORATIONS
  ═══════════════════════════════════════════════ */
  .fv-floral-right {
    position: absolute;
    top: -40px;
    left: -60px;
    width: 340px;
    height: 500px;
    color: #e8b4b8;
    opacity: 0.32;
    pointer-events: none;
    z-index: 1;
  }

  .fv-floral-left {
    position: absolute;
    bottom: -40px;
    right: -30px;
    width: 160px;
    height: 230px;
    color: #e8b4b8;
    opacity: 0.38;
    pointer-events: none;
    z-index: 1;
  }

  @media (min-width: 1024px) {
    .fv-floral-left {
      width: 200px;
      height: 290px;
      bottom: -50px;
      right: -40px;
    }
  }

  /* ═══════════════════════════════════════════════
     LAYOUT
  ═══════════════════════════════════════════════ */
  .fv-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    max-width: 1180px;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .fv-grid {
      grid-template-columns: 1fr minmax(320px, 0.85fr);
      gap: 6rem;
      align-items: start;
    }
  }

  /* ═══════════════════════════════════════════════
     IMAGE COLUMN
  ═══════════════════════════════════════════════ */
  .fv-image-column {
    position: relative;
    width: 100%;
    max-width: 460px;
    margin: 0 auto;
  }

  @media (min-width: 1024px) {
    .fv-image-column {
      margin: 0;
    }
  }

  .fv-number {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    color: var(--color-muted-foreground);
    margin-bottom: 0.75rem;
    opacity: 0.65;
  }

  .fv-number-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    font-style: italic;
  }

  .fv-number-digit {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-weight: 500;
    font-size: 1.6rem;
    line-height: 1;
  }

  .fv-image-card {
    position: relative;
    width: 100%;
  }

  /* Arched cream backdrop — sits behind the portrait, flush with its bottom */
  .fv-image-backdrop {
    position: absolute;
    top: 56px;
    left: 0;
    right: 0;
    bottom: 0;
    background: var(--color-secondary);
    border-radius: 9999px 9999px 20px 20px;
    border: 1px solid var(--color-border);
    z-index: 0;
  }

  /* Inner decorative ring inside the arched backdrop */
  .fv-image-backdrop::after {
    content: '';
    position: absolute;
    inset: 12px;
    border-radius: 9999px 9999px 12px 12px;
    border: 1px solid rgba(232, 180, 184, 0.45);
    pointer-events: none;
    transition: border-color 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .fv-image-card:hover .fv-image-backdrop::after {
    border-color: rgba(246, 131, 19, 0.55);
  }

  @media (min-width: 1024px) {
    .fv-image-backdrop {
      top: 70px;
    }
  }

  /* Portrait wrap — slightly narrower than backdrop, taller so head overflows */
  .fv-image-wrap {
    position: relative;
    z-index: 1;
    width: 82%;
    margin: 0 auto;
    aspect-ratio: 4 / 5;
  }

  .fv-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  /* Floating plaque */
  .fv-plaque {
    position: absolute;
    left: -8px;
    bottom: -28px;
    background: var(--color-background);
    padding: 1rem 1.25rem 1.1rem;
    border-radius: 12px;
    border: 1px solid var(--color-border);
    box-shadow: 0 18px 40px -20px rgba(15, 9, 6, 0.25);
    min-width: 200px;
    text-align: left;
    z-index: 3;
  }

  @media (min-width: 1024px) {
    .fv-plaque {
      left: -40px;
      bottom: -32px;
      min-width: 220px;
      padding: 1.1rem 1.35rem 1.25rem;
    }
  }

  .fv-plaque-label {
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--color-muted-foreground);
    opacity: 0.75;
    font-style: italic;
    margin: 0;
  }

  .fv-plaque-name {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-weight: 500;
    font-size: 1.4rem;
    color: var(--color-foreground);
    margin: 0.35rem 0 0.55rem;
    line-height: 1;
  }

  .fv-plaque-line {
    width: 24px;
    height: 1px;
    background: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .fv-plaque-role {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--color-muted-foreground);
    margin: 0;
  }

  /* ═══════════════════════════════════════════════
     CONTENT COLUMN
  ═══════════════════════════════════════════════ */
  .fv-content {
    padding-top: 1.5rem;
  }

  @media (min-width: 1024px) {
    .fv-content {
      padding-top: 1.75rem;
    }
  }

  .fv-heading {
    line-height: 1.12;
    max-width: 22ch;
  }

  .fv-divider {
    width: 3rem;
    height: 1px;
    background: var(--color-primary);
    margin: 1.75rem 0 1.5rem;
    transform-origin: left;
  }

  .fv-paragraphs {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
  }

  .fv-body {
    font-size: 0.95rem;
    line-height: 1.85;
    color: var(--color-muted-foreground);
    max-width: 58ch;
  }

  @media (min-width: 768px) {
    .fv-body {
      font-size: 1rem;
    }
  }

  .fv-highlight {
    color: var(--color-foreground);
    font-weight: 500;
  }

  .fv-body-accent {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-foreground);
    border-left: 2px solid var(--color-primary);
    padding-left: 1.15rem;
    margin-top: 0.5rem;
    font-weight: 400;
  }

  @media (min-width: 768px) {
    .fv-body-accent {
      font-size: 1.15rem;
    }
  }

  .fv-em {
    font-family: 'Playfair Display', serif;
    font-style: italic;
    font-weight: 500;
    color: var(--color-primary);
  }

</style>
