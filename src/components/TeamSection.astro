---
const founder = {
  name: "Safiya Umar",
  role: "Founder & Group CEO",
  image: "/images/team/safiya-umar-founder-&-group-ceo.webp",
};

const leaders = [
  { name: "Rita Ogbuagu", role: "CEO, Flott Beauty Port Harcourt", image: "/images/team/rita-ogbuagu-ceo-flott-beauty-portharcourt.webp" },
  { name: "Zulaihat Adamu Barde", role: "CEO, Abuja", image: "/images/team/zalihat-adamu-barde-abuja-ceo.jpg" },
  { name: "Maimuna Yakubu Adejoh", role: "CEO, Flott Beauty Kaduna", image: "/images/team/maimuna-yakubu-adejoh-ceo-flott-beauty-kaduna.webp" },
  { name: "Emek Akpan", role: "Co-CEO, Flott Beauty PH", image: "/images/team/emek-akpan-co-ceo-flott-beauty-portharcourt.webp" },
  { name: "Dr. Jane Onyeanusi", role: "CEO, Flott Beauty Enugu", image: "/images/team/dr.jane-onyeanusi-ceo-flott-beauty-enugu.webp" },
  { name: "Silvia Aboh", role: "Chief Head of Operations", image: "/images/team/silvia-aboh-chief-head-of-operations.webp" },
  { name: "Fatima Abubbakar", role: "CEO, Flott Beauty Ilorin", image: "/images/team/fatima-abubbakar-ceo-flott-beauty-ilorin.webp" },
];
---

<section class="relative overflow-hidden" style="background: var(--color-secondary);">

  <!-- Floral accents -->
  <svg class="ts-floral-r" viewBox="0 0 200 400" fill="none" stroke="currentColor" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M100 380 C105 320 120 280 110 220 C100 160 120 120 110 60 C104 30 90 15 100 2"/>
    <circle cx="100" cy="2" r="5"/><circle cx="100" cy="2" r="12"/>
    <path d="M100 -12 Q94 -22 100 -32 Q106 -22 100 -12Z"/>
    <path d="M114 -4 Q126 -10 132 -20 Q120 -8 114 -4Z"/>
    <path d="M86 -4 Q74 -10 68 -20 Q80 -8 86 -4Z"/>
    <circle cx="110" cy="220" r="4"/><circle cx="110" cy="220" r="10"/>
    <path d="M110 206 Q115 194 110 184 Q105 194 110 206Z"/>
    <path d="M123 214 Q134 208 140 198 Q128 206 123 214Z"/>
    <path d="M97 214 Q86 208 80 198 Q92 206 97 214Z"/>
    <path d="M110 300 C135 285 148 292 150 278 C152 264 135 260 110 280"/>
    <path d="M110 300 C85 285 72 292 70 278 C68 264 85 260 110 280"/>
  </svg>

  <svg class="ts-floral-l" viewBox="0 0 200 400" fill="none" stroke="currentColor" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M100 20 C95 80 80 120 90 180 C100 240 80 280 90 340 C96 370 110 385 100 398"/>
    <circle cx="100" cy="398" r="5"/><circle cx="100" cy="398" r="12"/>
    <path d="M100 412 Q106 422 100 432 Q94 422 100 412Z"/>
    <path d="M86 404 Q74 410 68 420 Q80 408 86 404Z"/>
    <path d="M114 404 Q126 410 132 420 Q120 408 114 404Z"/>
    <circle cx="90" cy="180" r="4"/><circle cx="90" cy="180" r="10"/>
    <path d="M90 166 Q95 154 90 144 Q85 154 90 166Z"/>
    <path d="M103 174 Q114 168 120 158 Q108 166 103 174Z"/>
    <path d="M77 174 Q66 168 60 158 Q72 166 77 174Z"/>
    <path d="M90 100 C65 85 52 92 50 78 C48 64 65 60 90 80"/>
    <path d="M90 100 C115 85 128 92 130 78 C132 64 115 60 90 80"/>
  </svg>

  <div class="relative z-10 px-6 py-16 md:px-12 md:py-24 lg:px-20 lg:py-32">

    <!-- Heading -->
    <div class="text-center mb-12 md:mb-16">
      <p class="blur-words text-xs uppercase tracking-[0.3em] text-muted-foreground mb-4" style="font-style: italic">The Women Behind It</p>
      <h2 class="word-blur-group text-3xl font-medium tracking-tight text-foreground md:text-4xl lg:text-5xl">
        <span class="word-blur" style="transition-delay: 0.1s">Women</span>
        <span class="word-blur" style="transition-delay: 0.2s">Who</span>
        <span class="word-blur" style="transition-delay: 0.3s">Hold</span>
        <span class="word-blur" style="transition-delay: 0.45s; font-family: 'Playfair Display', serif; font-style: italic; font-weight: 500;">Space</span>
      </h2>
    </div>

    <div class="mx-auto" style="max-width: 860px;">

      <!-- Founder -->
      <div class="ts-founder reveal">
        <div class="ts-founder-photo">
          <img src={founder.image} alt={founder.name} class="absolute inset-0 w-full h-full object-cover object-top" loading="eager" />
        </div>
        <div class="ts-founder-details">
          <p class="text-xs uppercase tracking-[0.25em] opacity-40 mb-auto">Founder</p>
          <p class="ts-quote" style="font-family: 'Playfair Display', serif; font-style: italic;">
            Rooted in wellness.<br/>Growing in community.
          </p>
          <div>
            <h3 class="text-xl md:text-2xl font-medium tracking-tight">{founder.name}</h3>
            <p class="text-sm opacity-50 mt-1">{founder.role}</p>
            <div class="mt-3 w-10 h-px" style="background: rgba(255,255,255,0.15);"></div>
          </div>
        </div>
      </div>

      <!-- All leaders in one grid -->
      <div class="ts-grid">
        {leaders.map((m, i) => (
          <div class="ts-member reveal" style={`transition-delay: ${0.08 + i * 0.07}s`}>
            <div class="ts-member-photo group">
              <img src={m.image} alt={m.name} class="absolute inset-0 w-full h-full object-cover object-center hover-zoom" loading="lazy" />
            </div>
            <h3 class="mt-3 text-sm font-semibold text-foreground leading-tight">{m.name}</h3>
            <p class="mt-0.5 text-xs text-muted-foreground leading-snug">{m.role}</p>
          </div>
        ))}

        <!-- CTA -->
        <div class="ts-cta-cell reveal" style="transition-delay: 0.6s">
          <div class="ts-cta-inner">
            <div class="ts-cta-bg"></div>
            <div class="relative z-10 ts-cta-content">
              <div class="ts-cta-text">
                <p class="text-[10px] sm:text-xs uppercase tracking-[0.2em] text-white/40 mb-1 sm:mb-2">Two Regions &middot; One Mission</p>
                <h3 class="text-lg sm:text-xl md:text-2xl font-medium text-white tracking-tight" style="font-family: 'Playfair Display', serif;">
                  Find your <span style="font-style: italic;">Circle</span>
                </h3>
              </div>
              <a href="#contact" class="ts-btn">
                Join Us
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>
              </a>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* Florals */
  .ts-floral-r, .ts-floral-l {
    position: absolute;
    color: #e8b4b8;
    opacity: 0.22;
    pointer-events: none;
    width: 140px;
    height: 280px;
  }
  .ts-floral-r { top: 40px; right: 0; }
  .ts-floral-l { bottom: 40px; left: 0; }
  @media (max-width: 768px) {
    .ts-floral-r, .ts-floral-l { display: none; }
  }

  /* Founder */
  .ts-founder {
    display: flex;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 6px 32px rgba(0,0,0,0.08);
    margin-bottom: 24px;
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ts-founder:hover { transform: translateY(-3px); }
  .ts-founder-photo {
    position: relative;
    width: 42%;
    min-height: 300px;
    flex-shrink: 0;
    overflow: hidden;
  }
  .ts-founder-photo img {
    transition: transform 1s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ts-founder:hover .ts-founder-photo img { transform: scale(1.04); }
  .ts-founder-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 24px 28px;
    background: #0F0906;
    color: #fff;
  }
  .ts-quote {
    font-size: 0.8rem;
    line-height: 1.7;
    opacity: 0.2;
    max-width: 190px;
    margin: auto 0;
  }
  @media (max-width: 480px) {
    .ts-founder { flex-direction: column; }
    .ts-founder-photo { width: 100%; min-height: 220px; aspect-ratio: 4/3; }
    .ts-founder-details { padding: 20px; gap: 12px; }
    .ts-quote { display: none; }
  }

  /* Leaders grid — desktop/tablet: row1=3, row2=4 via 12-col trick */
  .ts-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 16px;
  }
  /* First 3 items: span 4 cols each = 3 across */
  .ts-grid .ts-member:nth-child(1),
  .ts-grid .ts-member:nth-child(2),
  .ts-grid .ts-member:nth-child(3) {
    grid-column: span 4;
  }
  /* Next 4 items: span 3 cols each = 4 across */
  .ts-grid .ts-member:nth-child(4),
  .ts-grid .ts-member:nth-child(5),
  .ts-grid .ts-member:nth-child(6),
  .ts-grid .ts-member:nth-child(7) {
    grid-column: span 3;
  }
  /* CTA spans full width */
  .ts-grid .ts-cta-cell {
    grid-column: 1 / -1;
  }
  /* Mobile only: simple 2-col, ignore the 12-col system */
  @media (max-width: 480px) {
    .ts-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }
    .ts-grid .ts-member:nth-child(1),
    .ts-grid .ts-member:nth-child(2),
    .ts-grid .ts-member:nth-child(3),
    .ts-grid .ts-member:nth-child(4),
    .ts-grid .ts-member:nth-child(5),
    .ts-grid .ts-member:nth-child(6),
    .ts-grid .ts-member:nth-child(7) {
      grid-column: span 1;
    }
    .ts-grid .ts-cta-cell {
      grid-column: span 1;
    }
  }

  .ts-member {
    text-align: center;
  }
  .ts-member-photo {
    position: relative;
    aspect-ratio: 3/4;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.06);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.4s ease;
  }
  .ts-member:hover .ts-member-photo {
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
  }

  /* CTA cell */
  .ts-cta-cell {}
  .ts-cta-inner {
    position: relative;
    border-radius: 12px;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 3/4;
  }
  .ts-cta-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 12px;
    height: 100%;
    padding: 16px;
  }
  @media (min-width: 481px) {
    .ts-cta-inner {
      aspect-ratio: auto;
    }
    .ts-cta-content {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
      padding: 28px 40px;
      gap: 20px;
    }
  }
  .ts-cta-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #0F0906 0%, #2a1a14 50%, #1a0e08 100%);
  }
  .ts-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    background: #e8b4b8;
    color: #0F0906;
    white-space: nowrap;
    transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .ts-btn:hover {
    background: #fff;
    transform: translateX(4px);
    box-shadow: 0 4px 20px rgba(232,180,184,0.4);
  }
  .ts-btn svg { transition: transform 0.3s ease; }
  .ts-btn:hover svg { transform: translateX(3px); }
</style>
