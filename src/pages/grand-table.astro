                <span class="text-base text-[#F5F0E6] md:text-lg" style="font-family: 'Playfair Display', serif; font-weight: 400;">{faq.q}</span>
                <span class="gt-faq-icon relative shrink-0" aria-hidden="true">
                  <span class="gt-faq-icon-line gt-faq-icon-h"></span>
                  <span class="gt-faq-icon-line gt-faq-icon-v"></span>
                </span>
              </summary>
              <div class="gt-faq-content">
                <p class="pb-6 text-sm leading-relaxed text-[#F5F0E6]/70">{faq.a}</p>
              </div>
            </details>
          ))}
          <div class="border-t" style="border-color: rgba(201,169,110,0.18);" aria-hidden="true"></div>
        </div>
      </div>
    </section>

    <!-- ══════════════ CONTACT ══════════════ -->
    <section id="contact" class="relative overflow-hidden" style="background: #F5F0E6;">
      <div class="px-6 py-20 md:px-12 md:py-28 lg:px-20 lg:py-32">
        <div class="mx-auto max-w-3xl text-center">
          <p class="reveal text-[10px] uppercase tracking-[0.35em] text-[#9A7B45] md:text-xs" style="font-style: italic;">Contact</p>

          <h2
            class="reveal mt-4 text-[clamp(2.5rem,5vw,4.5rem)] leading-[1.05] tracking-[-0.02em] text-[#0B0B0C]"
            style="font-family: 'Playfair Display', serif; font-weight: 400; transition-delay: 0.1s;"
          >
            Get in <span style="font-style: italic; font-weight: 500; color: #9A7B45;">touch</span>
          </h2>

          <p class="reveal mx-auto mt-6 max-w-2xl text-base leading-relaxed text-[#0B0B0C]/70 md:text-lg" style="transition-delay: 0.2s;">
            Email and phone details will be announced soon.
          </p>
        </div>

        <div id="contact-form" class="mt-16 md:mt-20">
          <GrandTableForm form={forms.contact} theme="light" />
        </div>
      </div>
    </section>

    <FooterSection variant="gold" />
  </main>
</Layout>

