            class="reveal mt-4 text-[clamp(2.5rem,5vw,4.5rem)] leading-[1.05] tracking-[-0.02em] text-[#F5F0E6]"
            style="font-family: 'Playfair Display', serif; font-weight: 400; transition-delay: 0.08s;"
          >
            {copy.delegates.headingPrefix} <span style="font-style: italic; font-weight: 500; color: #C9A96E;">{copy.delegates.headingEmphasis}</span>
          </h2>

          <p class="reveal mx-auto mt-6 max-w-2xl text-base leading-relaxed text-[#F5F0E6]/70 md:text-lg" style="transition-delay: 0.16s;">
            {copy.delegates.body}
          </p>
        </div>

        <!-- Five reasons to participate -->
        <div class="mx-auto mt-16 max-w-5xl md:mt-20">
          <p class="reveal text-center text-[11px] uppercase tracking-[0.35em] text-[#C9A96E]/80" style="transition-delay: 0.24s;">{copy.delegates.reasonsLabel}</p>

          <!-- DRAFT COPY: replace with the 5 reasons from client brief when received -->
          <div class="mt-10 grid grid-cols-1 gap-8 md:mt-12 lg:grid-cols-6 lg:gap-x-8 lg:gap-y-10">
            {delegateReasons.map((reason, index) => (
              <div
                class={`gt-reason-card reveal border-t pt-6 lg:col-span-2 ${index === 3 ? "lg:col-start-2" : index === 4 ? "lg:col-start-4" : ""}`}
                style={`border-color: rgba(201,169,110,0.2); transition-delay: ${0.32 + index * 0.08}s;`}
              >
                <div class="flex items-center gap-3">
                  <span class="gt-reason-icon flex h-11 w-11 shrink-0 items-center justify-center rounded-full border" style="border-color: rgba(201,169,110,0.4);" aria-hidden="true">
                    <svg class="h-5 w-5" viewBox="0 0 28 28" fill="none" stroke="#C9A96E" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><Fragment set:html={reason.icon} /></svg>
                  </span>
                  <span class="text-[11px] uppercase tracking-[0.3em] text-[#C9A96E]/70">{reason.num}</span>
                </div>
                <h3 class="mt-4 text-base font-medium text-[#F5F0E6]">{reason.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-[#F5F0E6]/70">{reason.description}</p>
              </div>
            ))}
          </div>
        </div>

        <!-- Participation fee -->
        <div class="mx-auto mt-16 max-w-3xl md:mt-20">
          <p class="reveal text-center text-[11px] uppercase tracking-[0.3em] text-[#C9A96E]/80" style="transition-delay: 0.3s;">{copy.delegates.feeLabel}</p>
          <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2">
            {entryPackages.map((pkg, index) => (
              <div
                class="gt-tier-card reveal flex flex-col rounded-xl border px-6 py-8 text-center md:px-8"
                style={`border-color: rgba(201,169,110,0.35); transition-delay: ${0.34 + index * 0.08}s;`}
              >
                <h3 class="text-[11px] uppercase tracking-[0.3em] text-[#C9A96E]">{pkg.name}</h3>
                <p class="mt-3 text-[clamp(1.8rem,3.4vw,2.6rem)] leading-none text-[#F5F0E6]" style="font-family: 'Playfair Display', serif; font-weight: 400;">{fmt.usd(pkg.price.usd)}</p>
                <p class="mt-2 text-xs tracking-[0.04em] text-[#F5F0E6]/55">{secondaryLine(pkg.price)}</p>
                <p class="mt-3 inline-block self-center rounded-full border px-4 py-1.5 text-[11px] uppercase tracking-[0.18em] text-[#E6D3A3]" style="border-color: rgba(201,169,110,0.4);">{pkg.passLabel}</p>
                <ul class="mt-5 space-y-2 text-left text-[0.85rem] leading-relaxed text-[#F5F0E6]/70" role="list">
                  {pkg.bullets.map((bullet) => (
                    <li class="flex gap-2">
                      <span aria-hidden="true" class="text-[#C9A96E]">&bull;</span>
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
          <p class="reveal mt-6 text-center text-xs leading-relaxed text-[#F5F0E6]/50" style="transition-delay: 0.5s;">{copy.delegates.feeNote}</p>
        </div>

        <!-- CTA -->
        <div id="gt-delegate-cta" class="reveal mt-10 flex flex-col items-center gap-3 md:mt-12" style="transition-delay: 0.38s;">
          <p class="text-sm leading-relaxed text-[#F5F0E6]/70">Delegates, investors and partners register here</p>
          <a
            href="#delegate-form"
            class="inline-flex items-center justify-center gap-2 rounded-full px-8 py-4 text-xs font-medium uppercase tracking-[0.15em] transition-all duration-500 hover:gap-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#E6D3A3]"
            style="background: #C9A96E; color: #0B0B0C; transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);"
          >
            Register as a Delegate
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        <div class="mt-16 md:mt-20">
          <div class="flex justify-center">
            <div
              role="tablist"
              aria-label={copy.delegates.formTabsLabel}
              class="gt-form-tabs inline-flex rounded-full border p-1"
              style="border-color: rgba(201,169,110,0.35);"
            >
              <button
                type="button"
                role="tab"
                id="gt-form-tab-delegate"
                aria-selected="true"
                aria-controls="delegate-panel"
                tabindex="0"
                data-gt-form-tab="delegate"
                class="gt-form-tab"
              >
                {copy.delegates.tabs.delegate}
              </button>
              <button
                type="button"
                role="tab"
                id="gt-form-tab-investor"
                aria-selected="false"
                aria-controls="investor-panel"
                tabindex="-1"
                data-gt-form-tab="investor"
                class="gt-form-tab"
              >
                {copy.delegates.tabs.investor}
              </button>
            </div>
          </div>

          <div id="delegate-panel" role="tabpanel" aria-labelledby="gt-form-tab-delegate" data-gt-form-panel="delegate" class="mt-10">
            <GrandTableForm form={forms.delegate} theme="dark" />
          </div>
          <div id="investor-panel" role="tabpanel" aria-labelledby="gt-form-tab-investor" data-gt-form-panel="investor" class="mt-10" hidden>
            <GrandTableForm form={forms.investor} theme="dark" />
          </div>
        </div>
      </div>
    </section>

    <div class="gt-seam gt-seam-to-ivory" aria-hidden="true"></div>

    <!-- ══════════════ SPONSORSHIP ══════════════ -->
    <section id="sponsorship" class="relative overflow-hidden" style="background: #F5F0E6;">
      <div class="px-6 py-20 md:px-12 md:py-28 lg:px-20 lg:py-32">
        <div class="mx-auto max-w-3xl text-center">
          <p class="reveal text-[10px] uppercase tracking-[0.35em] text-[#9A7B45] md:text-xs" style="font-style: italic;">{copy.sponsorship.eyebrow}</p>

          <h2
            class="reveal mt-4 text-[clamp(2.5rem,5vw,4.5rem)] leading-[1.05] tracking-[-0.02em] text-[#0B0B0C]"
            style="font-family: 'Playfair Display', serif; font-weight: 400; transition-delay: 0.08s;"
          >
            {copy.sponsorship.headingPrefix} <span style="font-style: italic; font-weight: 500; color: #9A7B45;">{copy.sponsorship.headingEmphasis}</span>
          </h2>

          <p class="reveal mx-auto mt-6 max-w-2xl text-base leading-relaxed text-[#0B0B0C]/70 md:text-lg" style="transition-delay: 0.16s;">
            {copy.sponsorship.body}
          </p>
        </div>

        <!-- Tiers -->
        <div class="mx-auto mt-14 grid max-w-6xl grid-cols-1 gap-6 sm:grid-cols-2 md:mt-16 lg:grid-cols-3">
          {sponsorPackages.map((tier, index) => (
            <div
              class={`gt-tier-card reveal relative flex flex-col rounded-xl border px-6 py-8 text-center ${tier.featured ? "gt-tier-featured" : ""}`}
              style={`border-color: ${tier.featured ? "#9A7B45" : "rgba(154,123,69,0.35)"}; background: ${tier.featured ? "#0B0B0C" : "transparent"}; transition-delay: ${0.24 + index * 0.08}s;`}
            >
              {tier.featured && (
                <span
                  class="absolute -top-3 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full border px-3 py-1 text-[9px] uppercase tracking-[0.25em]"
                  style="background: #0B0B0C; border-color: #9A7B45; color: #C9A96E;"
                >
                  Headline partner
                </span>
              )}
              <h3
                class="text-[11px] uppercase tracking-[0.3em]"
                style={`color: ${tier.featured ? "#C9A96E" : "#9A7B45"};`}
              >
                {tier.name}
              </h3>
              <p
                class={`mt-4 whitespace-nowrap text-[clamp(1.9rem,3vw,2.4rem)] leading-tight ${tier.featured ? "text-[#F5F0E6]" : "text-[#0B0B0C]"}`}
                style="font-family: 'Playfair Display', serif; font-weight: 400;"
              >
                {fmt.usd(tier.price.usd)}
              </p>
              <p class={`mt-2 text-[11.5px] tracking-[0.02em] ${tier.featured ? "text-[#F5F0E6]/60" : "text-[#0B0B0C]/55"}`}>{secondaryLine(tier.price)}</p>
              <p class={`mt-4 text-[11px] uppercase tracking-[0.2em] ${tier.featured ? "text-[#E6D3A3]" : "text-[#9A7B45]"}`}>{tier.passLabel}</p>
              <ul class={`mt-4 space-y-1.5 text-left text-[0.8rem] leading-relaxed ${tier.featured ? "text-[#F5F0E6]/65" : "text-[#0B0B0C]/60"}`} role="list">
                {tier.bullets.map((bullet) => (
                  <li class="flex gap-2">
                    <span aria-hidden="true" class={tier.featured ? "text-[#C9A96E]" : "text-[#9A7B45]"}>&bull;</span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
              <a
                href="#sponsor-form"
                class={`gt-brochure-link mt-4 inline-flex items-center justify-center gap-1.5 text-[11px] uppercase tracking-[0.2em] transition-all duration-300 hover:gap-2.5 ${tier.featured ? "text-[#C9A96E]/70 hover:text-[#C9A96E]" : "text-[#0B0B0C]/50 hover:text-[#9A7B45]"}`}
              >
                See brochure
                <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            </div>
          ))}
        </div>

        <!-- Important information -->
        <div class="reveal mx-auto mt-10 max-w-3xl rounded-xl border px-6 py-6 text-left md:px-8" style="border-color: rgba(154,123,69,0.35); transition-delay: 0.64s;">
          <p class="text-[11px] uppercase tracking-[0.3em] text-[#9A7B45]">Important Information</p>
          <ul class="mt-4 space-y-2 text-sm leading-relaxed text-[#0B0B0C]/70" role="list">
            {importantInformation.map((item) => (
              <li class="flex gap-2">
                <span aria-hidden="true" class="text-[#9A7B45]">&bull;</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <p class="mt-4 text-sm leading-relaxed text-[#0B0B0C]/70"><span class="font-medium text-[#0B0B0C]">Currency Disclaimer:</span> {currencyDisclaimer}</p>
          <p class="mt-2 text-sm leading-relaxed text-[#0B0B0C]/70"><span class="font-medium text-[#0B0B0C]">Exchange Rates Used:</span> {exchangeRatesLine}</p>
        </div>

        <!-- CTA -->
        <div class="reveal mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center md:mt-12" style="transition-delay: 0.56s;">
          <a
            href="#sponsor-form"
            class="inline-flex w-full max-w-[340px] items-center justify-center gap-2 rounded-full px-8 py-4 text-xs font-medium uppercase tracking-[0.15em] transition-all duration-500 hover:gap-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#9A7B45] sm:w-auto sm:max-w-none"
            style="background: #0B0B0C; color: #F5F0E6; transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);"
          >
            Request Brochure
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a
            href="#sponsor-form"
            class="inline-flex w-full max-w-[340px] items-center justify-center gap-2 rounded-full border px-8 py-4 text-xs font-medium uppercase tracking-[0.15em] text-[#0B0B0C] transition-all duration-500 hover:gap-4 hover:border-[#9A7B45] hover:bg-[#9A7B45]/10 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#9A7B45] sm:w-auto sm:max-w-none"
            style="border-color: rgba(154,123,69,0.5); transition-timing-function: cubic-bezier(0.22, 1, 0.36, 1);"
          >
            Become a Sponsor
          </a>
        </div>

        <div id="sponsor-form" class="mt-16 md:mt-20">
          <GrandTableForm form={forms.sponsor} theme="light" />
        </div>
      </div>
    </section>

    <!-- ══════════════ VENUE ══════════════ -->
    <section id="venue" class="relative overflow-hidden border-t" style="background: #F5F0E6; border-color: rgba(154,123,69,0.25);">
      <div class="px-6 py-[4.5rem] md:px-12 lg:px-20 lg:py-[6rem]">
        <div class="mx-auto max-w-3xl text-center">
          <p class="reveal text-[10px] uppercase tracking-[0.35em] text-[#9A7B45] md:text-xs" style="font-style: italic;">{copy.venue.eyebrow}</p>

          <h2
            class="reveal mt-4 text-[clamp(2.25rem,4.5vw,3.75rem)] leading-[1.05] tracking-[-0.02em] text-[#0B0B0C]"
            style="font-family: 'Playfair Display', serif; font-weight: 400; transition-delay: 0.1s;"
          >
            {copy.venue.headingPrefix} <span style="font-style: italic; font-weight: 500; color: #9A7B45;">{copy.venue.headingEmphasis}</span>
          </h2>

          <div class="reveal mx-auto mt-10 max-w-md rounded-2xl border px-8 py-10" style="border-color: rgba(154,123,69,0.35); transition-delay: 0.2s;">
            <svg class="mx-auto h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="#9A7B45" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/>
            </svg>
            <p class="mt-5 text-[1.5rem] leading-tight" style="font-family: 'Playfair Display', serif; font-style: italic; font-weight: 500; color: #9A7B45;">{venue.officialName}</p>
            <p class="mt-2 text-sm leading-relaxed text-[#0B0B0C]/70">{venue.address}</p>
            <p class="mt-5 text-xs uppercase tracking-[0.3em] text-[#0B0B0C]/60">{event.date.display}</p>
          </div>
        </div>
      </div>
    </section>

    <div class="gt-seam gt-seam-to-jet" aria-hidden="true"></div>

    <!-- ══════════════ FAQ ══════════════ -->
    <section id="faq" class="relative overflow-hidden" style="background: #0B0B0C;">
      <div class="px-6 py-20 md:px-12 md:py-28 lg:px-20 lg:py-32">
        <div class="mx-auto max-w-3xl text-center">
          <p class="reveal text-[10px] uppercase tracking-[0.35em] text-[#C9A96E] md:text-xs" style="font-style: italic;">{copy.faq.eyebrow}</p>

          <h2
            class="reveal mt-4 text-[clamp(2.5rem,5vw,4.5rem)] leading-[1.05] tracking-[-0.02em] text-[#F5F0E6]"
            style="font-family: 'Playfair Display', serif; font-weight: 400; transition-delay: 0.1s;"
          >
            {copy.faq.headingPrefix} <span style="font-style: italic; font-weight: 500; color: #C9A96E;">{copy.faq.headingEmphasis}</span>
          </h2>
        </div>

        <div class="mx-auto mt-14 max-w-3xl md:mt-16">
          {faqs.map((faq, index) => (
            <details class="gt-faq-item reveal border-t" style={`border-color: rgba(201,169,110,0.18); transition-delay: ${Math.min(index * 0.08, 0.56)}s;`}>
              <summary class="gt-faq-summary flex cursor-pointer list-none items-center justify-between gap-4 py-6 text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#E6D3A3]">
                <span class="text-base text-[#F5F0E6] md:text-lg" style="font-family: 'Playfair Display', serif; font-weight: 400;">{faq.q}</span>
                <span class="gt-faq-icon relative shrink-0" aria-hidden="true">
                  <span class="gt-faq-icon-line gt-faq-icon-h"></span>
                  <span class="gt-faq-icon-line gt-faq-icon-v"></span>
                </span>
              </summary>
              <div class="gt-faq-content">
                <p class="pb-6 text-sm leading-relaxed text-[#F5F0E6]/70">{faq.a}</p>
              </div>
            </details>
          ))}
          <div class="border-t" style="border-color: rgba(201,169,110,0.18);" aria-hidden="true"></div>
        </div>
      </div>
    </section>

    <div class="gt-seam gt-seam-to-ivory" aria-hidden="true"></div>

    <!-- ══════════════ CONTACT ══════════════ -->
    <section id="contact" class="relative overflow-hidden" style="background: #F5F0E6;">
      <div class="px-6 py-20 md:px-12 md:py-28 lg:px-20 lg:py-32">
        <div class="mx-auto max-w-3xl text-center">
          <p class="reveal text-[10px] uppercase tracking-[0.35em] text-[#9A7B45] md:text-xs" style="font-style: italic;">{copy.contact.eyebrow}</p>

          <h2
            class="reveal mt-4 text-[clamp(2.5rem,5vw,4.5rem)] leading-[1.05] tracking-[-0.02em] text-[#0B0B0C]"
            style="font-family: 'Playfair Display', serif; font-weight: 400; transition-delay: 0.1s;"
          >
            {copy.contact.headingPrefix} <span style="font-style: italic; font-weight: 500; color: #9A7B45;">{copy.contact.headingEmphasis}</span>
          </h2>

          <p class="reveal mx-auto mt-6 max-w-2xl text-base leading-relaxed text-[#0B0B0C]/70 md:text-lg" style="transition-delay: 0.2s;">
            {copy.contact.body}
          </p>
        </div>

        <div class="reveal mx-auto mt-12 grid max-w-3xl gap-4 sm:grid-cols-2">
          <a href={`mailto:${contactDetails.email}`} class="gt-contact-card flex flex-col items-center justify-center rounded-xl border px-6 py-7 text-center transition-colors duration-300 hover:border-[#9A7B45]" style="border-color: rgba(154,123,69,0.35);">
            <span class="text-[10px] uppercase tracking-[0.3em] text-[#9A7B45]">{copy.contact.emailLabel}</span>
            <span class="mt-3 break-all text-lg text-[#0B0B0C]" style="font-family: 'Playfair Display', serif;">{contactDetails.email}</span>
          </a>
          <div class="flex flex-col items-center justify-center rounded-xl border px-6 py-7 text-center" style="border-color: rgba(154,123,69,0.35);">
            <span class="text-[10px] uppercase tracking-[0.3em] text-[#9A7B45]">{copy.contact.phoneLabel}</span>
            <ul class="mt-3 space-y-2" role="list">
              {contactDetails.phones.map((ph) => (
                <li class="flex items-center justify-center gap-3 text-[0.95rem] text-[#0B0B0C]">
                  <a href={`tel:${ph.tel}`} class="hover:text-[#9A7B45]" aria-label={`Call ${ph.display}`}>{ph.display}</a>
                  {ph.whatsapp && (
                    <a href={`https://wa.me/${ph.whatsapp}`} target="_blank" rel="noopener noreferrer" class="rounded-full border px-2.5 py-0.5 text-[10px] uppercase tracking-[0.18em] text-[#9A7B45] hover:bg-[#9A7B45]/10" style="border-color: rgba(154,123,69,0.45);" aria-label={`WhatsApp ${ph.display}`}>WhatsApp</a>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div id="contact-form" class="mt-16 md:mt-20">
          <GrandTableForm form={forms.contact} theme="light" />
        </div>
      </div>
    </section>

    <FooterSection variant="gold" />
  </main>
</Layout>

<style>
  .gt-logo { height: calc(var(--h) * 0.8); }
  @media (min-width: 640px) { .gt-logo { height: var(--h); } }

  section[id],
  #enterprise-form,
  #delegate-form,
  #investor-form,
  #sponsor-form,
  #contact-form,
  .gt-form-tabs {
    scroll-margin-top: 112px;
  }

  @media (min-width: 768px) {
    section[id],
    #enterprise-form,
    #delegate-form,
    #investor-form,
    #sponsor-form,
    #contact-form,
    .gt-form-tabs {
      scroll-margin-top: 124px;
    }
  }

  .gt-beam {
    animation: gtBeamBreathe 8s ease-in-out infinite;
  }

  .gt-source {
    animation: gtSourceBreathe 8s ease-in-out infinite;
  }

  @keyframes gtBeamBreathe {
    0%, 100% { opacity: 0.65; }
    50% { opacity: 1; }
  }

  @keyframes gtSourceBreathe {
    0%, 100% { opacity: 0.35; }
    50% { opacity: 0.55; }
  }

  .gt-table-ambient,
  .gt-reflection-pool {
    animation: gtGlowPulse 10s ease-in-out infinite;
  }

  @keyframes gtGlowPulse {
    0%, 100% { opacity: 0.85; }
    50% { opacity: 1; }
  }

  .gt-scrollline::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent, #E6D3A3 50%, transparent);
    animation: gtScrollDrip 2.4s ease-in-out infinite;
  }

  @keyframes gtScrollDrip {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(100%); }
  }

  .gt-hero-poster-fallback {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .gt-beam,
    .gt-source,
    .gt-table-ambient,
    .gt-reflection-pool {
      animation: none;
    }
