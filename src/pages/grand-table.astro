<script>
  const GT_TARGET = new Date("2026-12-05T09:00:00+01:00").getTime();

  function gtUpdateCountdown() {
    const now = Date.now();
    const diff = Math.max(0, GT_TARGET - now);

    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
    const mins = Math.floor((diff / (1000 * 60)) % 60);
    const secs = Math.floor((diff / 1000) % 60);

    const pad = (n: number) => String(n).padStart(2, "0");

    const daysEl = document.getElementById("gt-days");
    const hoursEl = document.getElementById("gt-hours");
    const minsEl = document.getElementById("gt-mins");
    const secsEl = document.getElementById("gt-secs");

    if (daysEl) daysEl.textContent = pad(days);
    if (hoursEl) hoursEl.textContent = pad(hours);
    if (minsEl) minsEl.textContent = pad(mins);
    if (secsEl) secsEl.textContent = pad(secs);
  }

  gtUpdateCountdown();
  setInterval(gtUpdateCountdown, 1000);

  // Hide the "Initiated by / Partners announced soon" strip once the page
  // scrolls past the point where the nav becomes a sticky glass bar.
  const gtCreditStrip = document.getElementById("gt-credit-strip");
  if (gtCreditStrip) {
    const gtToggleCreditStrip = () => {
      gtCreditStrip.classList.toggle("gt-strip-hidden", window.scrollY > 80);
    };
    gtToggleCreditStrip();
    window.addEventListener("scroll", gtToggleCreditStrip, { passive: true });
  }

  // FAQ accordion: keep only one entry open at a time
  document.querySelectorAll(".gt-faq-item").forEach((item) => {
    item.addEventListener("toggle", () => {
      if (!(item as HTMLDetailsElement).open) return;
      document.querySelectorAll(".gt-faq-item").forEach((other) => {
        if (other !== item && (other as HTMLDetailsElement).open) {
          (other as HTMLDetailsElement).open = false;
        }
      });
    });
  });

  // Safety net: if the shared IntersectionObserver ever misses an element,
  // force it visible after 2.5s so nothing stays permanently hidden.
  setTimeout(() => {
    document.querySelectorAll(".reveal").forEach((el) => {
      if (el.classList.contains("visible")) return;
      const rect = el.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) {
        el.classList.add("visible");
      }
    });
  }, 2500);
</script>
