<script>
  const GT_TARGET = new Date((window as unknown as { GT_COUNTDOWN_TARGET: string }).GT_COUNTDOWN_TARGET).getTime();

  function gtUpdateCountdown() {
    const now = Date.now();
    const diff = Math.max(0, GT_TARGET - now);

    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
    const mins = Math.floor((diff / (1000 * 60)) % 60);
    const secs = Math.floor((diff / 1000) % 60);

    const pad = (n: number) => String(n).padStart(2, "0");

    const daysEl = document.getElementById("gt-days");
    const hoursEl = document.getElementById("gt-hours");
    const minsEl = document.getElementById("gt-mins");
    const secsEl = document.getElementById("gt-secs");

    if (daysEl) daysEl.textContent = pad(days);
    if (hoursEl) hoursEl.textContent = pad(hours);
    if (minsEl) minsEl.textContent = pad(mins);
    if (secsEl) secsEl.textContent = pad(secs);
  }

  gtUpdateCountdown();
  setInterval(gtUpdateCountdown, 1000);

  // Hide the organisers strip once the page scrolls past the point where
  // the nav becomes a sticky glass bar.
  const gtCreditStrip = document.getElementById("gt-credit-strip");
  if (gtCreditStrip) {
    const gtToggleCreditStrip = () => {
      gtCreditStrip.classList.toggle("gt-strip-hidden", window.scrollY > 80);
    };
    gtToggleCreditStrip();
    window.addEventListener("scroll", gtToggleCreditStrip, { passive: true });
  }

  // FAQ accordion: keep only one entry open at a time
  document.querySelectorAll(".gt-faq-item").forEach((item) => {
    item.addEventListener("toggle", () => {
      if (!(item as HTMLDetailsElement).open) return;
      document.querySelectorAll(".gt-faq-item").forEach((other) => {
        if (other !== item && (other as HTMLDetailsElement).open) {
          (other as HTMLDetailsElement).open = false;
        }
      });
    });
  });

  // Event Experience highlight strip: arrow nav, progress hairline, pointer drag-to-scroll
  const gtStrip = document.getElementById("gt-highlight-strip");
  if (gtStrip) {
    // Frames live in a horizontally scrolling row, so the shared per-element reveal
    // observer never sees frames parked off-screen to the right. Reveal them all together
    // when the strip itself enters the viewport; each frame's own transition-delay staggers it.
    const gtFrames = Array.from(gtStrip.querySelectorAll<HTMLElement>(".gt-highlight-frame"));
    const gtStripObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          gtFrames.forEach((frame) => frame.classList.add("visible"));
          gtStripObserver.unobserve(entry.target);
        });
      },
      { threshold: 0.08, rootMargin: "0px 0px -60px 0px" }
    );
    gtStripObserver.observe(gtStrip);

    const gtPrev = document.getElementById("gt-strip-prev") as HTMLButtonElement | null;
    const gtNext = document.getElementById("gt-strip-next") as HTMLButtonElement | null;
    const gtProgress = document.getElementById("gt-strip-progress") as HTMLElement | null;

    const gtFrameStep = () => {
      const frame = gtStrip.querySelector(".gt-highlight-frame") as HTMLElement | null;
      const gap = parseFloat(getComputedStyle(gtStrip).columnGap || "0") || 20;
      return (frame ? frame.getBoundingClientRect().width : gtStrip.clientWidth) + gap;
    };

    const gtUpdateStripUI = () => {
      const max = gtStrip.scrollWidth - gtStrip.clientWidth;
      const ratio = max > 0 ? gtStrip.scrollLeft / max : 0;
      if (gtProgress) gtProgress.style.width = `${Math.min(100, Math.max(6, ratio * 100))}%`;
      if (gtPrev) gtPrev.disabled = gtStrip.scrollLeft <= 2;
      if (gtNext) gtNext.disabled = gtStrip.scrollLeft >= max - 2;
    };

    gtPrev?.addEventListener("click", () => {
      gtStrip.scrollBy({ left: -gtFrameStep(), behavior: "smooth" });
    });
    gtNext?.addEventListener("click", () => {
      gtStrip.scrollBy({ left: gtFrameStep(), behavior: "smooth" });
    });

    gtStrip.addEventListener("scroll", gtUpdateStripUI, { passive: true });
    window.addEventListener("resize", gtUpdateStripUI);
    gtUpdateStripUI();

    // Pointer drag-to-scroll for mouse/pen; touch keeps native swipe
    let gtDragging = false;
    let gtDragMoved = false;
    let gtStartX = 0;
    let gtStartScroll = 0;

    gtStrip.addEventListener("pointerdown", (e) => {
      if (e.pointerType === "touch") return;
      gtDragging = true;
      gtDragMoved = false;
      gtStartX = e.clientX;
      gtStartScroll = gtStrip.scrollLeft;
      gtStrip.classList.add("gt-strip-grabbing");
    });

    gtStrip.addEventListener("pointermove", (e) => {
      if (!gtDragging) return;
      const dx = e.clientX - gtStartX;
      if (Math.abs(dx) > 3) gtDragMoved = true;
      gtStrip.scrollLeft = gtStartScroll - dx;
    });

    const gtEndDrag = () => {
      gtDragging = false;
      gtStrip.classList.remove("gt-strip-grabbing");
    };
    gtStrip.addEventListener("pointerup", gtEndDrag);
    gtStrip.addEventListener("pointerleave", gtEndDrag);
    gtStrip.addEventListener("pointercancel", gtEndDrag);

    // Only swallow the click that follows an actual drag; normal taps pass through untouched
    gtStrip.addEventListener(
      "click",
      (e) => {
        if (gtDragMoved) {
          e.preventDefault();
          e.stopPropagation();
        }
      },
      { capture: true }
    );
  }

  // Safety net: if the shared IntersectionObserver ever misses an element,
  // force it visible after 2.5s so nothing stays permanently hidden.
  setTimeout(() => {
    document.querySelectorAll(".reveal").forEach((el) => {
      if (el.classList.contains("visible")) return;
      const rect = el.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) {
        el.classList.add("visible");
      }
    });
  }, 2500);

  // Delegate / Investor registration tab toggle
  const gtFormTabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-gt-form-tab]"));
  const gtFormPanels = Array.from(document.querySelectorAll<HTMLElement>("[data-gt-form-panel]"));
  if (gtFormTabs.length && gtFormPanels.length) {
    const gtActivateFormTab = (key: string, focusTab = false) => {
      gtFormTabs.forEach((tab) => {
        const active = tab.dataset.gtFormTab === key;
        tab.setAttribute("aria-selected", active ? "true" : "false");
        tab.tabIndex = active ? 0 : -1;
        if (active && focusTab) tab.focus();
      });
      gtFormPanels.forEach((panel) => {
        panel.hidden = panel.dataset.gtFormPanel !== key;
      });
    };

    gtFormTabs.forEach((tab) => {
      tab.addEventListener("click", () => gtActivateFormTab(tab.dataset.gtFormTab || "delegate"));
      tab.addEventListener("keydown", (e) => {
        const index = gtFormTabs.indexOf(tab);
        let nextIndex: number | null = null;
        if (e.key === "ArrowRight" || e.key === "ArrowDown") nextIndex = (index + 1) % gtFormTabs.length;
        else if (e.key === "ArrowLeft" || e.key === "ArrowUp") nextIndex = (index - 1 + gtFormTabs.length) % gtFormTabs.length;
        else if (e.key === "Home") nextIndex = 0;
        else if (e.key === "End") nextIndex = gtFormTabs.length - 1;
        if (nextIndex !== null) {
          e.preventDefault();
          gtActivateFormTab(gtFormTabs[nextIndex].dataset.gtFormTab || "delegate", true);
        }
      });
    });

    // Deep links to either tabbed form land on the tab pill (not the form below it),
    // so the Delegate | Investor/Partner toggle stays visible under the fixed nav.
    const gtScrollToFormTabs = (smooth: boolean) => {
      const tabs = document.querySelector(".gt-form-tabs");
      if (tabs) tabs.scrollIntoView({ block: "start", behavior: smooth ? "smooth" : "auto" });
    };
    const gtHandleFormHash = (smooth: boolean) => {
      const hash = window.location.hash;
      const wantsInvestor = hash === "#investor-form" || new URLSearchParams(window.location.search).get("form") === "investor";
      if (wantsInvestor) gtActivateFormTab("investor");
      else if (hash === "#delegate-form") gtActivateFormTab("delegate");
      else return;
      requestAnimationFrame(() => gtScrollToFormTabs(smooth));
      setTimeout(() => gtScrollToFormTabs(false), 400);
    };
    document.querySelectorAll('a[href="#investor-form"], a[href="#delegate-form"]').forEach((link) => {
      link.addEventListener("click", (e) => {
        e.preventDefault();
        history.pushState(null, "", link.getAttribute("href"));
        gtHandleFormHash(true);
      });
    });
    window.addEventListener("hashchange", () => gtHandleFormHash(true));
    gtHandleFormHash(false);

    // Fade the "Register as a Delegate" CTA out while the tabbed forms are in view,
    // so it never sits half-hidden behind the fixed nav.
    const gtDelegateCta = document.getElementById("gt-delegate-cta");
    const gtFormTabsWrap = document.querySelector(".gt-form-tabs")?.parentElement?.parentElement;
    if (gtDelegateCta && gtFormTabsWrap && "IntersectionObserver" in window) {
      gtDelegateCta.style.transition = "opacity 0.4s ease";
      new IntersectionObserver(
        ([entry]) => {
          const hide = entry.isIntersecting;
          gtDelegateCta.style.opacity = hide ? "0" : "";
          gtDelegateCta.style.pointerEvents = hide ? "none" : "";
          gtDelegateCta.toggleAttribute("aria-hidden", hide);
          gtDelegateCta.querySelector("a")?.setAttribute("tabindex", hide ? "-1" : "0");
        },
        { rootMargin: "-140px 0px 0px 0px" }
      ).observe(gtFormTabsWrap);
    }
  }
</script>
