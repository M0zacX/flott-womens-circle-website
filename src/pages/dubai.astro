<style>
  .dubai-hero-bg {
    transform: scale(1.06);
    animation: dubaiHeroKen 28s ease-in-out infinite alternate;
    will-change: transform;
  }
  @keyframes dubaiHeroKen {
    from { transform: scale(1.06) translateY(0); }
    to   { transform: scale(1.13) translateY(-1.5%); }
  }

  /* FAQ accordion */
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item[open] .faq-icon { transform: rotate(45deg); }

  @media (prefers-reduced-motion: reduce) {
    .dubai-hero-bg { animation: none; transform: scale(1.06); }
  }
</style>

<script>
  // Waitlist form — submit via Web3Forms without a page redirect
  const wf = document.getElementById("waitlist-form") as HTMLFormElement | null;
  const wSuccess = document.getElementById("waitlist-success");
  const wBtn = wf?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

  wf?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (wBtn) wBtn.disabled = true;
    try {
      const res = await fetch("https://api.web3forms.com/submit", {
        method: "POST",
        body: new FormData(wf),
      });
      const data = await res.json();
      if (data.success) {
        wf.style.display = "none";
        if (wSuccess) {
          wSuccess.classList.remove("hidden");
          wSuccess.scrollIntoView({ behavior: "smooth", block: "center" });
        }
      } else {
        throw new Error("submit failed");
      }
    } catch {
      if (wBtn) {
        wBtn.disabled = false;
        wBtn.firstChild && (wBtn.firstChild.textContent = "Try again ");
      }
    }
  });
</script>
